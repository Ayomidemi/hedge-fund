APP_NAME=Hedge Fund API
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:3000

# Local Docker Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hedge_fund

# Supabase Postgres also works. Use the async SQLAlchemy driver prefix:
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@[host]:6543/postgres
