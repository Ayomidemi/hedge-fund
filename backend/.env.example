APP_NAME=Hedge Fund API
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:3000

# Local Docker Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hedge_fund

# Supabase Postgres pooler also works. The backend prefers this value when set.
# Raw passwords are accepted and normalized by the backend.
# HF_SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres

# Supabase Auth (required to protect API routes)
# HF_SUPABASE_URL=https://your-project-ref.supabase.co
# HF_SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Modern Supabase projects also verify ES256 tokens via JWKS when HF_SUPABASE_URL is set.
